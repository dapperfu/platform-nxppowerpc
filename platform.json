{
  "name": "nxppowerpc",
  "title": "NXP PowerPC VLE",
  "description": "PlatformIO development platform for the NXP DEVKIT-MPC5744P (MPC5744P / e200z4) using the PowerPC EABI VLE toolchain and a baremetal framework.",
  "homepage": "https://www.nxp.com/devkit-mpc5744p",
  "license": "Apache-2.0",
  "keywords": [
    "dev-platform",
    "NXP",
    "PowerPC",
    "VLE",
    "MPC5744P",
    "DEVKIT-MPC5744P"
  ],
  "engines": {
    "platformio": "^6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dapperfu/platform-nxppowerpc.git"
  },
  "version": "1.0.0",
  "frameworks": {
    "baremetal": {
      "package": null,
      "script": "builder/frameworks/baremetal.py"
    }
  },
  "packages": {
    "toolchain-powerpc-eabivle": {
      "type": "toolchain",
      "optional": true,
      "version": "https://github.com/dapperfu/platform-nxppowerpc/releases/download/v.0.0.1/gcc-4.9.4-Ee200-eabivle-x86_64-linux-g2724867.zip"
    }
  },
  "examples": [
    {"name": "Hello_World", "base": "examples/Hello_World", "files": ["platformio.ini"]},
    {"name": "Hello_World_PLL", "base": "examples/Hello_World_PLL", "files": ["platformio.ini"]},
    {"name": "Hello_World_PLL_Interrupt", "base": "examples/Hello_World_PLL_Interrupt", "files": ["platformio.ini"]},
    {"name": "ADC_MPC5744P", "base": "examples/ADC_MPC5744P", "files": ["platformio.ini"]},
    {"name": "eDMA_MPC5744P", "base": "examples/eDMA_MPC5744P", "files": ["platformio.ini"]},
    {"name": "eTimer_MPC5744P", "base": "examples/eTimer_MPC5744P", "files": ["platformio.ini"]},
    {"name": "eTimer_Freq_Measurement_MPC5744P", "base": "examples/eTimer_Freq_Measurement_MPC5744P", "files": ["platformio.ini"]},
    {"name": "FlexCAN_MPC5744P", "base": "examples/FlexCAN_MPC5744P", "files": ["platformio.ini"]},
    {"name": "LINFlexD_UART_MPC5744P", "base": "examples/LINFlexD_UART_MPC5744P", "files": ["platformio.ini"]},
    {"name": "LINFlexD_LIN_Master_MPC5744P", "base": "examples/LINFlexD_LIN_Master_MPC5744P", "files": ["platformio.ini"]},
    {"name": "LINFlexD_LIN_Slave_MPC5744P", "base": "examples/LINFlexD_LIN_Slave_MPC5744P", "files": ["platformio.ini"]},
    {"name": "SPI_MPC5744P", "base": "examples/SPI_MPC5744P", "files": ["platformio.ini"]},
    {"name": "SPI_DMA_MPC5744P", "base": "examples/SPI_DMA_MPC5744P", "files": ["platformio.ini"]},
    {"name": "FLASH_ECC_Error_Injection_MPC5744P", "base": "examples/FLASH_ECC_Error_Injection_MPC5744P", "files": ["platformio.ini"]},
    {"name": "FCCU_MPC5744P", "base": "examples/FCCU_MPC5744P", "files": ["platformio.ini"]},
    {"name": "TSENS_MPC5744P", "base": "examples/TSENS_MPC5744P", "files": ["platformio.ini"]},
    {"name": "XBIC_DMA_MPC5744P", "base": "examples/XBIC_DMA_MPC5744P", "files": ["platformio.ini"]},
    {"name": "LP_STOP_MPC5744P", "base": "examples/LP_STOP_MPC5744P", "files": ["platformio.ini"]},
    {"name": "SIUL_RegisterProtection_MPC5744P", "base": "examples/SIUL_RegisterProtection_MPC5744P", "files": ["platformio.ini"]}
  ]
}
